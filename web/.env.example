# Local development requires NO env vars — the Vite dev server proxies all
# /api/* requests to Strapi (http://localhost:1337) automatically.
#
# Only set VITE_STRAPI_URL if you want to override the default behaviour,
# e.g. to point your local frontend at the cloud Strapi instance:
#   VITE_STRAPI_URL=https://elegant-eggs-b247740f2b.strapiapp.com
#
# For production builds the cloud URL is used automatically when this is unset.
VITE_STRAPI_URL=
